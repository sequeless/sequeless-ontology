<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent-less aggregator (spec 11, section 7). Each module takes sequeless-build-parent directly. -->
  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-ontology</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Sequeless Ontology</name>
  <description>Domain ontology model for Sequeless: core types and a reference OWL adapter,
    built as a hexagonal Maven reactor. No Spring dependency.</description>
  <url>https://sequeless.org</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>ontology-core</module>
    <module>schema-contract</module>
    <module>behaviour-contract</module>
    <module>automation-contract</module>
    <module>ontology-jena-adapter</module>
    <module>ontology-testfixtures</module>
    <module>facet-core</module>
    <module>facet-core-testfixtures</module>
  </modules>

  <!-- Deploy target for the reusable release workflow (release-please, sequeless-build). -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/sequeless-ontology</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/sequeless-ontology</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spotless.version>2.46.1</spotless.version>
  </properties>

  <build>
    <plugins>
      <!-- Keeps this pom.xml sorted. The modules get their Java and pom formatting from the parent. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <pom>
            <includes>
              <include>pom.xml</include>
            </includes>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
