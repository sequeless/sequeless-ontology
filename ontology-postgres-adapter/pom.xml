<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>ontology-postgres-adapter</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>Sequeless Ontology Postgres Adapter</name>
  <description>PostgreSQL-backed OntologyDocumentStore over the sq_ontology_document table. Plain JDBC, no Spring.
    Ships no migration: the table is created by store-postgres-jsonb-adapter, which its tests take at test scope.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <sequeless.github.repository>sequeless-ontology</sequeless.github.repository>
    <flatten.version>1.9.0</flatten.version>
    <junit-jupiter.version>5.14.4</junit-jupiter.version>
    <assertj-core.version>3.27.7</assertj-core.version>
    <extra-enforcer-rules.version>1.13.0</extra-enforcer-rules.version>
    <!-- Versions the store-postgres-jsonb-adapter 0.1.0 build resolves through the Spring Boot 4.1.1 BOM. -->
    <postgresql.version>42.7.13</postgresql.version>
    <testcontainers.version>2.0.5</testcontainers.version>

    <!-- JaCoCo line-coverage check: off until the module opts in (CONTRIBUTING.md, Coverage). -->
    <jacoco.check.skip>true</jacoco.check.skip>
    <jacoco.line.min>0.10</jacoco.line.min>
    <jacoco.check.dataFile>${project.build.directory}/jacoco.exec</jacoco.check.dataFile>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-core</artifactId>
      <version>0.2.0</version>
    </dependency>
    <!-- The port's signatures and the store's Scope come from kernel-identity; declared so it is not used undeclared. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
      <version>0.1.1</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-testfixtures</artifactId>
      <version>0.2.0</version>
      <scope>test</scope>
    </dependency>
    <!--
      The schema comes from the store's migrations (Q2, Q-F). store-core brings ontology-core 0.1.0 and
      the store adapter brings Spring JDBC and Spring TX; this module must be Spring-free and single-version
      on ontology-core 0.2.0, so both are excluded here. PostgresMigrations needs only java.*, javax.sql and Flyway.
    -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-postgres-jsonb-adapter</artifactId>
      <version>0.1.0</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.sequeless</groupId>
          <artifactId>ontology-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.springframework</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import archunit and archunit-junit5-api directly, so they stay declared, or dependency:analyze reports them as used undeclared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Declared here, as the sibling modules do, so Maven can fetch the sequeless-build-parent POM and the store adapter. -->
  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <dependencies>
          <!-- banDuplicateClasses comes from extra-enforcer-rules. -->
          <dependency>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <version>${extra-enforcer-rules.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>ban-spring</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                  </excludes>
                  <message>sequeless-ontology must stay transport-agnostic — no Spring dependency.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <!--
            Single version of ontology-core on the classpath (ontology-core 0.2.0). Deliberately not
            dependencyConvergence, which fails under the BOM skew. Duplicate classes are the defect that matters.
          -->
          <execution>
            <id>single-ontology-core</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <banDuplicateClasses>
                  <findAllDuplicates>true</findAllDuplicates>
                  <ignoreWhenIdentical>true</ignoreWhenIdentical>
                </banDuplicateClasses>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <dataFile>${jacoco.check.dataFile}</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
