<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>ontology-jena-adapter</artifactId>
  <version>0.1.2</version>
  <packaging>jar</packaging>

  <name>Sequeless Ontology Jena Adapter</name>
  <description>Reference adapter translating the ontology domain model to and from OWL, via a
    hexagonal port depending only on ontology-core's published api.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <sequeless.github.repository>sequeless-ontology</sequeless.github.repository>
    <flatten.version>1.6.0</flatten.version>
    <!-- The parent manages only ArchUnit, so this module pins what it uses (spec 5.3, D24). jena.version is the prototype root's. -->
    <jackson-databind.version>2.18.3</jackson-databind.version>
    <jena.version>6.1.0</jena.version>
    <junit-jupiter.version>5.11.4</junit-jupiter.version>
    <assertj-core.version>3.26.3</assertj-core.version>
    <mockito-core.version>5.14.2</mockito-core.version>

    <!-- JaCoCo line-coverage check: off until the module opts in (CONTRIBUTING.md, Coverage). -->
    <jacoco.check.skip>true</jacoco.check.skip>
    <jacoco.line.min>0.10</jacoco.line.min>
    <jacoco.check.dataFile>${project.build.directory}/jacoco.exec</jacoco.check.dataFile>
  </properties>

  <!--
    Convergence pins for Jena 6's transitive commons artifacts. The prototype gets these from its
    root dependencyManagement and the Spring Boot BOM; this module has neither, so the highest
    version any path asks for is pinned here (commons-io 2.22.0 over 2.20.0, commons-codec 1.22.0
    over 1.19.0, commons-lang3 3.20.0 over 3.18.0). commons-io 2.22.0 and commons-lang3 3.20.0 are
    the versions the prototype resolves. commons-codec 1.22.0 is the highest version a Jena path
    asks for; the prototype resolves 1.21.0 through the Spring Boot BOM, so this module pins higher.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>2.22.0</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>1.22.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.20.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-core</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>behaviour-contract</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-contract</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>filter-core</artifactId>
      <version>0.1.3</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson-databind.version}</version>
    </dependency>

    <!--
      The prototype excludes jcl-over-slf4j here because Spring Boot's spring-jcl provides the same
      org.apache.commons.logging classes in the packaged app. The exclusion travels to consumers.
    -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-ontapi</artifactId>
      <version>${jena.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>jcl-over-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-core</artifactId>
      <version>${jena.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-arq</artifactId>
      <version>${jena.version}</version>
    </dependency>
    <!-- Backs ShaclValidationPort. Its only compile dependency is jena-arq, already declared above. -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-shacl</artifactId>
      <version>${jena.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-testfixtures</artifactId>
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito-core.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import archunit and archunit-junit5-api directly, so they stay declared, or dependency:analyze reports them as used undeclared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Declared here, as sequeless-filter does, so Maven can fetch the sequeless-build-parent POM itself. -->
  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-spring</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                  </excludes>
                  <message>sequeless-ontology must stay transport-agnostic — no Spring dependency.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <dataFile>${jacoco.check.dataFile}</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
